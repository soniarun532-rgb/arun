#%RAML 1.0 ResourceType
uses:
  t: ../libraries/traits.raml
  types: ../libraries/types.raml

description: Store collection
get:
  displayName: Get Store
  description: Retrieve Store records for the given date range.
  is:
    - t.storeQuery
    - t.errorResponses
  responses:
    200:
      description: Successful retrieval of Store records
      body:
        application/json:
          type: types.StoreCollection
          examples:
            success: !include ../examples/records.json
