#%RAML 1.0 ResourceType
uses:
  t: ../libraries/traits.raml
  types: ../libraries/types.raml

description: Invoice collection
get:
  displayName: Get Invoice
  description: Retrieve Invoice records for the given date range.
  is:
    - t.invoiceQuery
    - t.errorResponses
  responses:
    200:
      description: Successful retrieval of Invoice records
      body:
        application/json:
          type: types.InvoiceCollection
          examples:
            success: !include ../examples/records.json
