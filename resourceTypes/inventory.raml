#%RAML 1.0 ResourceType
uses:
  t: ../libraries/traits.raml
  types: ../libraries/types.raml

description: Inventory collection
get:
  displayName: Get Inventory
  description: Retrieve Inventory records for the given date range.
  is:
    - t.inventoryQuery
    - t.errorResponses
  responses:
    200:
      description: Successful retrieval of Inventory records
      body:
        application/json:
          type: types.InventoryCollection
          examples:
            success: !include ../examples/records.json
