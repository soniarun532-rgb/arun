#%RAML 1.0 ResourceType
uses:
  t: ../libraries/traits.raml
  types: ../libraries/types.raml

description: SalesRep collection
get:
  displayName: Get SalesRep
  description: Retrieve SalesRep records for the given date range.
  is:
    - t.salesRepQuery
    - t.errorResponses
  responses:
    200:
      description: Successful retrieval of SalesRep records
      body:
        application/json:
          type: types.SalesRepCollection
          examples:
            success: !include ../examples/records.json
