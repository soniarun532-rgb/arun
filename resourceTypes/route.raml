#%RAML 1.0 ResourceType
uses:
  t: ../libraries/traits.raml
  types: ../libraries/types.raml

description: Route collection
get:
  displayName: Get Route
  description: Retrieve Route records for the given date range.
  is:
    - t.routeQuery
    - t.errorResponses
  responses:
    200:
      description: Successful retrieval of Route records
      body:
        application/json:
          type: types.RouteCollection
          examples:
            success: !include ../examples/records.json
