#%RAML 1.0 Trait
usage: Query parameters for GET /v1/warehouses. All values are strings so this trait can be changed independently.

queryParameters:
  productId:
    type: string
    required: false
    description: Filter warehouses associated with a product identifier
    example: P1001
  productName:
    type: string
    required: false
    description: Filter warehouses associated with a product name
    example: BIC
  fromDate:
    type: string
    required: true
    description: Inclusive warehouse effective start date (YYYY-MM-DD)
    example: "2026-08-01"
  toDate:
    type: string
    required: true
    description: Inclusive warehouse effective end date (YYYY-MM-DD)
    example: "2026-08-10"
  limit:
    type: string
    required: false
    default: "500"
    description: Page size. Maximum recommended value is 1000.
    example: "500"
  offset:
    type: string
    required: false
    default: "0"
    description: Number of records to skip for pagination
    example: "0"
