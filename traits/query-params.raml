#%RAML 1.0 Trait
usage: Shared query parameters for SAT Datashare collection GETs. All query parameters are strings so each resource can later override types independently.

queryParameters:
  productId:
    type: string
    required: false
    description: Optional product identifier filter
    example: P1001
  productName:
    type: string
    required: false
    description: Optional product name filter
    example: BIC
  fromDate:
    type: string
    required: true
    description: Inclusive start date filter (YYYY-MM-DD)
    example: "2026-08-01"
  toDate:
    type: string
    required: true
    description: Inclusive end date filter (YYYY-MM-DD)
    example: "2026-08-10"
  limit:
    type: string
    required: false
    default: "500"
    description: Page size. Maximum recommended value is 1000.
    example: "500"
  offset:
    type: string
    required: false
    default: "0"
    description: Number of records to skip for pagination
    example: "0"
