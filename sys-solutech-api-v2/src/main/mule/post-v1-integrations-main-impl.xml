<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	
	    <flow name="post-v1-integrations-main-impl" doc:id="b9a20809-edc3-4db1-b0c7-740f2bab0a14">

        <!-- 1 Capture incoming payload -->
        <logger level="INFO" doc:name="StartLogger" doc:id="2debe0c1-2626-493e-921e-bbd7f4866587" message='#["Starting the " ++ flow.name ++ " of " ++ vars.request_path ++ " at " ++ now() as String]'/>
        <logger level="INFO" doc:name="[ERP-Solutech] POST Invoked. Payload"
                message="[ERP-Solutech] POST Invoked. Payload: #[write(payload, 'application/json', {indent:2})]" />

        <!-- 2 Get OAuth Token -->
        <flow-ref 
            doc:name="Get Token"
            name="post:\oauth\token:application\x-www-form-urlencoded:solutech-system-main-config" />

    <logger level="INFO" doc:name="receivedPayload" doc:id="b7d02012-b059-42ba-8ccc-f50aec2af38a" message="receivedPayload:#[vars.receivedPayload]"/>
		<logger level="INFO" 
        doc:name="URL being sent to Solutech" 
        doc:id="0ca17d32-297e-4c49-a66d-9849295b3058" 
        message='#["URL being sent to Solutech: https://" ++ (vars.api default "") ++ "/api/v1/integrations/" ++ (trim(vars.request_path) default "")]'/>
    		<http:request method="#[vars.request_method]" config-ref="HTTP_Request_Solutech_Token_config" path='#["/api/v1/integrations/"++ trim(vars.request_path)]' doc:name="POST to Solutech ERP">
        <reconnect count="3" blocking="false" />
			<http:body><![CDATA[#[vars.receivedPayload]]]></http:body>
        <http:headers><![CDATA[#[{
            'Authorization': 'Bearer ' ++ vars.access_token,
            'Content-Type': 'application/json'
        }]]]></http:headers>
        <http:response-validator>
            <http:success-status-code-validator values="0..599" />
        </http:response-validator>
    </http:request>
        <logger level="INFO" doc:name="[ERP-Solutech] POST Received. Payload" doc:id="1fef8638-ec25-4513-9e42-7421a8e71d6e" message="Payload being received from Solutech: #[payload]" />
        <logger level="INFO" doc:name="EndLogger" doc:id="f13dd0c4-1b35-46f1-b80b-9a47565278c2" message='#["Ending the " ++ flow.name ++ " of " ++ vars.request_path ++ " at " ++ now() as String]'/>

    </flow>
</mule>
