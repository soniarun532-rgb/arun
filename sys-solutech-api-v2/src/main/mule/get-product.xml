<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!-- Endpoint D: GET /api/Product — bi_products filtered by Supplier -->
	<flow name="get-Product-main" doc:id="d0a1e001-product-get-mysql-0001">
		<http:listener doc:name="GET /api/Product" doc:id="d0a1e001-product-listener-0001" config-ref="solutech-system-api-httpListenerConfig" path="/api/Product" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[output application/java
---
{
	"Content-Type": "application/json"
}]]]></http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[output application/java
---
{
	"Content-Type": "application/json"
}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<logger level="INFO" doc:name="Start GET Product" message='#["Starting GET /api/Product queryParams=" ++ write(attributes.queryParams default {}, "application/json")]' />
		<ee:transform doc:name="Validate Product query params">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="Database"><![CDATA[attributes.queryParams.Database default ""]]></ee:set-variable>
				<ee:set-variable variableName="Supplier"><![CDATA[attributes.queryParams.Supplier default ""]]></ee:set-variable>
				<ee:set-variable variableName="PageNumber"><![CDATA[(attributes.queryParams.PageNumber default "1") as Number default 1]]></ee:set-variable>
				<ee:set-variable variableName="pageSize"><![CDATA[(p("db.page.size") default "100") as Number]]></ee:set-variable>
				<ee:set-variable variableName="validationError"><![CDATA[%dw 2.0
output application/java
var dbName = attributes.queryParams.Database default ""
var supplier = attributes.queryParams.Supplier default ""
var page = (attributes.queryParams.PageNumber default "1") as String
---
if (dbName == "" or !(dbName matches /^[A-Za-z][A-Za-z0-9_]*$/))
	"Database is required and must be a valid schema name"
else if (supplier == "")
	"Supplier is required"
else if (!(page matches /^\d+$/) or ((page as Number) < 1))
	"PageNumber must be a positive integer"
else
	null]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Product params valid?">
			<when expression="#[vars.validationError != null]">
				<ee:transform doc:name="400 Product">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	status: 400,
	error: vars.validationError
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="Build Product SQL">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="sql"><![CDATA[%dw 2.0
output text/plain
var schema = vars.Database
var offset = ((vars.PageNumber as Number) - 1) * (vars.pageSize as Number)
---
"SELECT id AS ProductID, productcode AS ProductCode, product_category AS ProductCategory, product_name AS ProductName, product_desc AS ProductDescription, product_status AS ProductStatus, short_code AS ShortCode, tax_code AS TaxCode, hs_code AS HsCode, product_type AS ProductType, supplier AS Supplier FROM " ++ schema ++ ".bi_products WHERE supplier = :supplier ORDER BY id LIMIT " ++ (vars.pageSize as String) ++ " OFFSET " ++ (offset as String)]]></ee:set-variable>
						<ee:set-variable variableName="sqlParams"><![CDATA[%dw 2.0
output application/java
---
{
	supplier: vars.Supplier
}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="Product SQL" message='#["GET /api/Product supplier=" ++ vars.Supplier ++ " database=" ++ vars.Database ++ " page=" ++ vars.PageNumber]' />
				<db:select doc:name="Query bi_products" config-ref="MySQL_Config">
					<db:sql><![CDATA[#[vars.sql]]]></db:sql>
					<db:input-parameters><![CDATA[#[vars.sqlParams]]]></db:input-parameters>
				</db:select>
				<ee:transform doc:name="Product JSON page">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	status: "success",
	endpoint: "Product",
	pageNumber: vars.PageNumber as Number,
	pageSize: vars.pageSize as Number,
	count: sizeOf(payload default []),
	data: payload default []
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="End GET Product" message='#["Ending GET /api/Product httpStatus=" ++ (vars.httpStatus default 200)]' />
		<error-handler ref="global-error-handler" />
	</flow>
</mule>
