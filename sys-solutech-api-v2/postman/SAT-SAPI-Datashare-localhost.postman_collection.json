{
  "info": {
    "_postman_id": "sat-sys-solutech-datashare-localhost",
    "name": "SAT SAPI Datashare (localhost)",
    "description": "Trigger APIkit GET /api/datashare on local SAPI (port 8081). PAPI resources call this one endpoint with a different resource query param. Follow payload.next until it is null.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "database", "value": "sat_nobleoutlook" },
    { "key": "fromDate", "value": "2026-08-13" },
    { "key": "toDate", "value": "2026-08-14" },
    { "key": "limit", "value": "10000" },
    { "key": "offset", "value": "0" },
    { "key": "supplier", "value": "BIC EAST AFRCA LIMITED" }
  ],
  "item": [
    {
      "name": "Invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/datashare?resource=Invoice&database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&limit={{limit}}&offset={{offset}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "datashare"],
          "query": [
            { "key": "resource", "value": "Invoice" },
            { "key": "database", "value": "{{database}}" },
            { "key": "fromDate", "value": "{{fromDate}}" },
            { "key": "toDate", "value": "{{toDate}}" },
            { "key": "limit", "value": "{{limit}}" },
            { "key": "offset", "value": "{{offset}}" }
