/Adapter_Order:
  get:
    displayName: Adapter_Order 
    description: Retrieves Adapter_Order records from mySQL.
    is: [ bearerAuth, queryp_Order ]
    responses:
      200:
        body:
          example: !include examples/Adapter_Order-get-response.json
      400:
        body:
          example: |
            {
              "message": "The given data was invalid.",
              "errors": { "fromDate": [ "The fromDate field is required." ] },
              "status_code": 400
            }
      401:
        body: { type: 401_error }
      500:
        body: { type: 500_error }
