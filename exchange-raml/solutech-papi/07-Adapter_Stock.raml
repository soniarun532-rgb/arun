/Adapter_Stock:
  get:
    displayName: Adapter_Stock 
    description: Retrieves Adapter_Stock records from mySQL.
    is: [ bearerAuth, queryp_Stock ]
    responses:
      200:
        body:
          example: !include examples/Adapter_Stock-get-response.json
      400:
        body:
          example: |
            {
              "message": "The given data was invalid.",
              "errors": { "fromDate": [ "The fromDate field is required." ] },
              "status_code": 400
            }
      401:
        body: { type: 401_error }
      500:
        body: { type: 500_error }
