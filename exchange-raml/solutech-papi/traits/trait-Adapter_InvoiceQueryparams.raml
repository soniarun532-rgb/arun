#%RAML 1.0 Trait
queryParameters:
  fromDate:
    type: date-only
    required: true
    description: Inclusive start date (YYYY-MM-DD).
    example: 2026-08-13
  toDate:
    type: date-only
    required: true
    description: Inclusive end date (YYYY-MM-DD).
    example: 2026-08-14
  database:
    type: string
    required: true
    description: MySQL schema. Use sat_nobleoutlook.
    example: sat_nobleoutlook
  supplier:
    type: string
    required: true
    description: products.supplier filter.
    example: BIC EAST AFRCA LIMITED
  pageNumber:
    type: integer
    required: false
    default: 0
    description: 0-based page index.
    example: 0
