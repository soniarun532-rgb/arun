#%RAML 1.0 Trait
# GET Adapter_Stock: pageNumber only (plus database/supplier from Experience).
queryParameters:
  database:
    type: string
    required: true
    description: MySQL schema. Experience injects this.
    example: sat_nobleoutlook
  supplier:
    type: string
    required: true
    description: products.supplier filter. Experience injects this.
    example: BIC EAST AFRCA LIMITED
  pageNumber:
    type: integer
    required: false
    default: 0
    description: 0-based page. OFFSET = pageNumber * SAPI page size (10000). First call can omit it.
    example: 0
