#%RAML 1.0 Trait
# SAPI GET /stock — pageNumber only (plus database and supplier from PAPI).
queryParameters:
  database:
    type: string
    required: true
    example: sat_nobleoutlook
  supplier:
    type: string
    required: true
    example: BIC EAST AFRCA LIMITED
  pageNumber:
    type: integer
    required: false
    default: 0
    description: Only paging param. fromDate and toDate are not used.
    example: 0
