#%RAML 1.0
title: exp-sat-datashare-api-prod
version: v1
baseUri: /api
mediaType: application/json
description: SAT Datashare Experience API. Clients never send database or supplier. Experience injects them from exp.sat.solutech.mysql.database and exp.sat.solutech.mysql.supplier.

traits:
  dateQuery:
    queryParameters:
      fromDate:
        type: date-only
        required: true
        description: Inclusive start date. YYYY-MM-DD only. No time.
        example: 2026-08-13
      toDate:
        type: date-only
        required: true
        description: Inclusive end date. YYYY-MM-DD only. No time.
        example: 2026-08-14
      pageNumber:
        type: integer
        required: false
        default: 0
        description: 0-based page. First call can omit it. Follow payload.next if present.
        example: 0
  pageNumberQuery:
    queryParameters:
      pageNumber:
        type: integer
        required: false
        default: 0
        description: 0-based page. First call can omit it. Follow payload.next if present.
        example: 0

/v1/Invoice:
  get:
    displayName: Invoice
    description: fromDate and toDate required. pageNumber optional. Do not send database or supplier.
    is: [ dateQuery ]
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Order:
  get:
    displayName: Order
    description: fromDate and toDate required. pageNumber optional. Do not send database or supplier.
    is: [ dateQuery ]
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Product:
  get:
    displayName: Product
    description: No query parameters. Experience injects database and supplier. Follow payload.next if present.
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Route:
  get:
    displayName: Route
    description: No query parameters. Experience injects database and supplier. Follow payload.next if present.
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/SalesRep:
  get:
    displayName: SalesRep
    description: No query parameters. Experience injects database and supplier. Follow payload.next if present.
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Customer:
  get:
    displayName: Customer
    description: fromDate and toDate required. pageNumber optional. Do not send database or supplier.
    is: [ dateQuery ]
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Stock:
  get:
    displayName: Stock
    description: Only pageNumber. Do not send fromDate, toDate, database, or supplier.
    is: [ pageNumberQuery ]
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }

/v1/Warehouse:
  get:
    displayName: Warehouse
    description: No query parameters. Experience injects database and supplier. Follow payload.next if present.
    responses:
      200:
        body:
          application/json:
            example: |
              { "data": [] }
