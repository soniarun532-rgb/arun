				<ee:set-variable variableName="adapterPublicPath"><![CDATA[p("sys.solutech.adapter.invoice.path") default "/api/Adapter_Invoice"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="get-sat-datashare-adapter-main" name="get-sat-datashare-adapter-main" />
