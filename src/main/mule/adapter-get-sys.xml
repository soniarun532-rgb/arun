	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<sub-flow name="store-Sys-Get-QueryParams" doc:id="93f6a9c2-75be-40d1-998d-21120a4dbe7a">
		<ee:transform doc:name="Set Sys GET query variables">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="access_token"><![CDATA[%dw 2.0
output application/java
---
p("sys.solutech.access_token")]]></ee:set-variable>
				<ee:set-variable variableName="request_method"><![CDATA[%dw 2.0
output application/java
---
"GET"]]></ee:set-variable>
				<ee:set-variable variableName="sysQueryParams"><![CDATA[%dw 2.0
output application/java
var fromDate = (attributes.queryParams.fromDate default "") as String
var toDate = (attributes.queryParams.toDate default "") as String
---
{
	(fromDate: fromDate) if (fromDate != ""),
	(toDate: toDate) if (toDate != ""),
	database: (attributes.queryParams.database as String) default "",
	supplier: (attributes.queryParams.supplier default attributes.queryParams.Supplier default "") as String,
	pageNumber: ((attributes.queryParams.pageNumber default 0) as Number) as String
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>

	<sub-flow name="get-sat-datashare-adapter-main" doc:id="get-sat-datashare-adapter-main-0001">
		<logger level="INFO" doc:name="Logger_JSON_adapter-start" message='#[output application/json ---
{
	timestamp: now() as String {format: "yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ"},
	layer: "prc-solutech-api",
	event: "adapter-get-start",
	adapter: (vars.adapterResource as String) default "",
	sysPath: (vars.request_path as String) default "",
	database: (attributes.queryParams.database as String) default "",
	pageNumber: (attributes.queryParams.pageNumber as String) default ""
}]' />
		<flow-ref doc:name="store-Sys-Get-QueryParams" name="store-Sys-Get-QueryParams" />
		<flow-ref doc:name="call-Sys-Solutech-Subflow" name="call-Sys-Solutech-Subflow" />
		<ee:transform doc:name="Map Sys fields and Experience next URL">
			<ee:message>
				<ee:set-payload resource="dwl/map-sapi-datashare.dwl" />
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger_JSON_adapter-end" message='#[output application/json ---
{
	timestamp: now() as String {format: "yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ"},
	layer: "prc-solutech-api",
	event: "adapter-get-complete",
	adapter: (vars.adapterResource as String) default "",
	hasNext: ((payload.next as String) default "") != "",
	rowCount: (sizeOf((payload.data default [])) as String) default ""
}]' />
	</sub-flow>

