<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <sub-flow name="call-prc-solutech-api-sub-flow" doc:name="call-prc-solutech-api-sub-flow">
        <ee:transform doc:name="Set process call variables">
            <ee:message />
            <ee:variables>
                <ee:set-variable variableName="inboundPath"><![CDATA[%dw 2.0
output application/java
---
attributes.requestPath]]></ee:set-variable>
                <ee:set-variable variableName="inboundQueryParams"><![CDATA[%dw 2.0
output application/java
---
attributes.queryParams default {}]]></ee:set-variable>
                <ee:set-variable variableName="endpoint"><![CDATA[%dw 2.0
output application/java
---
vars.endpoint default ((attributes.requestPath splitBy "/")[-1])]]></ee:set-variable>
                <ee:set-variable variableName="processQueryParams" resource="dwl/process-query-params.dwl" />
            </ee:variables>
        </ee:transform>
        <logger level="INFO" doc:name="Logger_JSON_call-prc-start" message='#[output application/json ---
{
	timestamp: now() as String {format: "yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ"},
	layer: "exp-sat-datashare-api",
	event: "call-prc-start",
	endpoint: (vars.endpoint as String) default "",
	pageNumber: (vars.processQueryParams.pageNumber as String) default ""
}]' />
        <http:request method="GET"
                      config-ref="HTTP_Request_config_prc-solutech-api"
                      path='#["/api/" ++ vars.endpoint]'
                      responseTimeout="${http.request.response.timeout}"
                      doc:name="HTTP_Request_GET_prc-solutech-api">
            <http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Test"
}]]]></http:headers>
            <http:query-params><![CDATA[#[vars.processQueryParams]]]></http:query-params>
        </http:request>
        <ee:transform doc:name="Set paging and status variables">
            <ee:message />
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[%dw 2.0
output application/java
---
attributes.statusCode default 200]]></ee:set-variable>
                <ee:set-variable variableName="lastCallHasMore"><![CDATA[%dw 2.0
output application/java
---
attributes.headers.'x-has-more' default "false"]]></ee:set-variable>
                <ee:set-variable variableName="paging" resource="dwl/paging.dwl" />
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Transform_Message_add-next-url">
            <ee:message>
                <ee:set-payload resource="dwl/add-next-url.dwl"/>
            </ee:message>
        </ee:transform>
        <set-variable variableName="outboundHeaders"
                      doc:name="Set_Variable_outboundHeaders"
                      value="#[output application/java
---
(vars.outboundHeaders default {})
    ++ { 'X-Has-More': (vars.paging.hasMore default false) as String }
    ++ (if (vars.paging.nextUrl != null) { 'X-Next-Url': vars.paging.nextUrl as String } else {})]"/>
        <logger level="INFO" doc:name="Logger_JSON_call-prc-complete" message='#[output application/json ---
{
	timestamp: now() as String {format: "yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ"},
	layer: "exp-sat-datashare-api",
	event: "call-prc-complete",
	endpoint: (vars.endpoint as String) default "",
	httpStatus: (vars.httpStatus as String) default "",
	hasMore: (vars.paging.hasMore as String) default "",
	rowCount: (sizeOf((payload.data default [])) as String) default ""
}]' />
    </sub-flow>
</mule>
