3d sizeOf(vars.Body.organization_code default \"\")\nvar length_customer_code \u003d sizeOf(vars.Body.customer_code default \"\")\n---\nif ( length_customer_code \u003e 0 ) {\n\t\"Customers\": [{\n\t\t\"Customer_No\": body.customer_code,\n\t\t\"EXT_Cust_Ref_No\": body.record_id\n\t}]\n}\nelse\n{\n\t\"Customers\": [{\n\t\t\"Customer_No\": \"\",\n\t\t\"Name\": body.name,\n\t\t\"Contact_Name\": body.contact_person,\n\t\t\"Address\": body.address,\n\t\t\"Address_2\": body.location,\n\t\t\"City\": body.region,\n\t\t\"Post_Code\": body.postal_address,\n\t\t\"Country_Code\": body.country_code,\n\t\t\"Phone_No\": body.phone_number,\n\t\t\"Email\": body.email,\n\t\t\"Gen_Bus_Posting_Group\": \"DOMESTIC\",\n\t\t\"Customer_Posting_Group\": body.category,\n\t\t\"Customer_Price_Group\": \"\",\n\t\t\"Customer_Disc_Group\": \"\",\n\t\t\"Tin_No\": body.vat_number,\n\t\t\"Solutech_Customer_Ref_No\": body.record_id as String,\n\t\t\"Blocked\": if ( body.account_status \u003d\u003d \"1\" ) 0\n                else if ( body.account_status \u003d\u003d \"0\" ) 1\n                else\n                    0,\n\t\t\"Credit_Limit\": body.credit_limit,\n\t\t\"Payment_Terms_Code\": body.payment_terms_code,\n\t\t\"VAT_Bus_Posting_Group\": \"LOCAL\",\n\t\t\"EXT_Cust_Ref_No\": body.record_id as String\n\t}]\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Customer-subflow\" doc:id\u003d\"a9e10cf4-22de-4c65-83eb-f95e60c73987\" name\u003d\"post-Business-Central-Adapter_Customer-subflow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" doc:id\u003d\"dcfffaa0-a673-4701-ace5-8c96f7c4172b\" message\u003d\"#[\"Ending the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e","startColumn":4,"startLine":189},"parameters":[{"unresolvedValue":"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]","metadata":{"doc