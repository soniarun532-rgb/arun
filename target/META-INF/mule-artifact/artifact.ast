output application/json\n---\n{\n\t\"Message\": \"INVALID VALUE: Sale,Order \u0026 Credit Note not found as a Document Type\"\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e","startColumn":5,"startLine":533},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"Choice","{http://www.mulesoft.org/schema/mule/documentation}id":"4d397f68-770e-446f-8d81-5c0c9c5d851c"}}],"componentType":"ROUTE","identifier":{"name":"when","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"Adapter_Sales_Document-main","parts":[{"partPath":"Adapter_Sales_Document-main","partIdentifier":{"identifier":{"name":"flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"FLOW"}},"fileName":"main.xml","line":363,"column":2},{"partPath":"processors"},{"partPath":"3","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"main.xml","line":383,"column":3},{"partPath":"route"},{"partPath":"0","partIdentifier":{"identifier":{"name":"when","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTE"}},"fileName":"main.xml","line":384,"column":4}],"location":"Adapter_Sales_Document-main/processors/3/route/0"},"metadata":{"docAttributes":{},"endColumn":8,"endLine":551,"fileName":"main.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/main.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":4},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":8},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":384},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":384},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":551},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":1},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":62},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":551}},"sourceCode":"\u003cwhen expression\u003d\"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]\"\u003e\r\n\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"dbf4f2c7-d17c-4a7d-9946-3f39b472898b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar value\u003d  (if ( upper(vars.Body.transaction_type) \u003d\u003d \"ORDER\" ) \"2\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"SALE\" ) \"1\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"5\" else \"\")\nvar Body \u003d vars.Body\nvar ts \u003d vars.Body.tax_sync_time\nvar ts_formatted \u003d (if (ts !\u003d null and ts !\u003d \"\")\n  (ts as LocalDateTime {format: \"yyyy-MM-dd HH:mm:ss\"})\n    as String {format: \"yyyy-MM-dd\u0027T\u0027HH:mm:ss\"}\nelse\n  ts)\n---\n//This is for sales with order(Converting sales orders to posted sales invoices)\nif ( vars.request_endpoint\u003d\u003d \"Integration_PostSalesDocument\" ) ({\n\t\"Documents\": [{\n\t\t\"Document_No\": Body.sales_order_erp_reference,\n\t\t\"Document_Type\": 2,\n\t\t\"Ship\": true,\n\t\t\"Invoice\": true,\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number,\n\t\t\"Items\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\t\"No.\": item.item_code,\n\t\t\t\"QtyToShip\": item.item_quantity,\n\t\t\t\"QtyToInvoice\": item.item_quantity\n\t\t})\n\t}]\n})\n//This is for orders and credit notes\nelse if ( vars.request_endpoint\u003d\u003d \"Integration_SalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": Body.lpo_number default \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,//1\u003dG/L Account, 2\u003dItem, 3\u003dResource\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\", //agreed with Lisa that the system will be auto populating it\n\t\t//\"VAT_Prod_Posting_Group\": \"\",//agreed with Lisa that the system will be auto populating it\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"//agreed with Lisa that the system will be auto populating it\n\t})\n})\n//This is for direct sales(Van sales) creation of Invoice and direct posting \nelse if ( vars.request_endpoint\u003d\u003d \"Integration_CreateAndPostSalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t//\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Promised_Delivery_Date\": \"2026-02-12\",\n\t\t\"External_Document_No\": Body.record_id as Number default \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t//\"Campaign_No\": \"\",\n\t\t//\"Opportunity_No\": \"\",\n\t\t//\"Responsibility_Center\": \"\",\n\t\t//\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\",\n\t\t//\"Invoice_ID\": Body.tax_verification_code\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 1,//1\u003d Item, 2\u003dG/L Account, 3\u003dResource,4\u003dFixed Asset\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate,\n\t\t\"Unit_Of_Measure\": item.uom_code,\n\t\t\"Location_Code\": item.store_code //confirmed by Lisa it is required \n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})\nelse \n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": Body.lpo_number default \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"4d397f68-770e-446f-8d81-5c0c9c5d851c\"\u003e\r\n\u003cwhen expression\u003d\"#[([\"1\",\"2\",\"5\"] contains (vars.TransformedPayload.SalesHeader.Document_Type)) or ([2] contains (vars.TransformedPayload.Documents.Document_Type[0]))]\"\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Sales_Document-subflow\" doc:id\u003d\"56fa5c40-ee73-4897-8e9c-864a6d9dd590\" name\u003d\"post-Business-Central-Adapter_Sales_Document-Subflow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"2c96f8fe-4d33-4946-9b9e-dffd78122d56\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"Message\": \"INVALID VALUE: Sale,Order \u0026 Credit Note not found as a Document Type\"\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e","startColumn":4,"startLine":384},"parameters":[{"unresolvedValue":"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]","metadata":{"docAttributes":{},"endColumn":8,"endLine":551,"fileName":"main.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/main.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":4},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":8},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":384},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":384},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":551},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":1},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":62},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":551}},"sourceCode":"\u003cwhen expression\u003d\"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]\"\u003e\r\n\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"dbf4f2c7-d17c-4a7d-9946-3f39b472898b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar value\u003d  (if ( upper(vars.Body.transaction_type) \u003d\u003d \"ORDER\" ) \"2\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"SALE\" ) \"1\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"5\" else \"\")\nvar Body \u003d vars.Body\nvar ts \u003d vars.Body.tax_sync_time\nvar ts_formatted \u003d (if (ts !\u003d null and ts !\u003d \"\")\n  (ts as LocalDateTime {format: \"yyyy-MM-dd HH:mm:ss\"})\n    as String {format: \"yyyy-MM-dd\u0027T\u0027HH:mm:ss\"}\nelse\n  ts)\n---\n//This is for sales with order(Converting sales orders to posted sales invoices)\nif ( vars.request_endpoint\u003d\u003d \"Integration_PostSalesDocument\" ) ({\n\t\"Documents\": [{\n\t\t\"Document_No\": Body.sales_order_erp_reference,\n\t\t\"Document_Type\": 2,\n\t\t\"Ship\": true,\n\t\t\"Invoice\": true,\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number,\n\t\t\"Items\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\t\"No.\": item.item_code,\n\t\t\t\"QtyToShip\": item.item_quantity,\n\t\t\t\"QtyToInvoice\": item.item_quantity\n\t\t})\n\t}]\n})\n//This is for orders and credit notes\nelse if ( vars.request_endpoint\u003d\u003d \"Integration_SalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": Body.lpo_number default \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,//1\u003dG/L Account, 2\u003dItem, 3\u003dResource\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\", //agreed with Lisa that the system will be auto populating it\n\t\t//\"VAT_Prod_Posting_Group\": \"\",//agreed with Lisa that the system will be auto populating it\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"//agreed with Lisa that the system will be auto populating it\n\t})\n})\n//This is for direct sales(Van sales) creation of Invoice and direct posting \nelse if ( vars.request_endpoint\u003d\u003d \"Integration_CreateAndPostSalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t//\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Promised_Delivery_Date\": \"2026-02-12\",\n\t\t\"External_Document_No\": Body.record_id as Number default \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t//\"Campaign_No\": \"\",\n\t\t//\"Opportunity_No\": \"\",\n\t\t//\"Responsibility_Center\": \"\",\n\t\t//\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\",\n\t\t//\"Invoice_ID\": Body.tax_verification_code\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 1,//1\u003d Item, 2\u003dG/L Account, 3\u003dResource,4\u003dFixed Asset\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate,\n\t\t\"Unit_Of_Measure\": item.uom_code,\n\t\t\"Location_Code\": item.store_code //confirmed by Lisa it is required \n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})\nelse \n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": Body.lpo_number default \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"4d397f68-770e-446f-8d81-5c0c9c5d851c\"\u003e\r\n\u003cwhen expression\u003d\"#[([\"1\",\"2\",\"5\"] contains (vars.TransformedPayload.SalesHeader.Document_Type)) or ([2] contains (vars.TransformedPayload.Documents.Document_Type[0]))]\"\u003e\r\n\u