003d null) -\u003e toExpNext(payload.next)\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" message\u003d\"#[\"Ending the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":35},"groupModelName":"General","modelName":"initialState","value":{"aString":"started"},"defaultValue":true},{"groupModelName":"General","modelName":"maxConcurrency","value":{},"defaultValue":true},{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true}],"componentId":"get-Adapter_Invoice-main-impl","extensionModel":{"name":"mule"},"modelName":"flow","modelType":"CONSTRUCT","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}id":"8a82a7a9-2042-47b8-af10-d0feb062b322"}},{"directChildren":[{"directChildren":[],"componentType":"OPERATION","identifier":{"name":"logger","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"get-Adapter_Customer-sys-impl","parts":[{"partPath":"get-Adapter_Customer-sys-impl","partIdentifier":{"identifier":{"name":"flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"FLOW"}},"fileName":"adapter-get-sys.xml","line":107,"column":2},{"partPath":"processors"},{"partPath":"0","partIdentifier":{"identifier":{"name":"logger","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"OPERATION"}},"fileName":"adapter-get-sys.xml","line":109,"column":3}],"location":"get-Adapter_Customer-sys-impl/processors/0"},"metadata":{"docAttributes":{"name":"Start Logger"},"endColumn":77,"endLine":110,"fileName":"adapter-get-sys.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/adapter-get-sys.xml","importLocationChain":[],"parserAttr