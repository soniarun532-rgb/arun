ion\": (Body.user_code default \"\") ++ \"-\" ++ ((invoice.record_id default Body.record_id) as String),\n                \"PostingDate\": postingDate,\n                \"Payment_Method\": Body.payment_mode,\n                \"Payment_Reference\": paymentReference,\n                \"CustNo\": Body.customer_code,\n\t\t        \"SalespersonCode\": Body.user_code \n            }\n        else\n            [\n                {\n                    \"InvoiceNo\": \"\",\n                    \"Amount\": Body.amount,\n                    \"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((Body.record_id default \"\") as String),\n                    \"PostingDate\": postingDate,\n                    \"Payment_Method\": Body.payment_mode,\n                    \"Payment_Reference\": paymentReference,\n                    \"CustNo\": Body.customer_code,\n\t\t            \"SalespersonCode\": Body.user_code  \n                }\n            ]\n}\n*/\n---\n{\n    \"Header\": {\n        \"PaymentNo\": (Body.record_id default \"\") as String,\n        \"CustNo\": Body.customer_code default \"\",\n        \"Payment_Amount\": Body.amount default 0,\n        \"Payment_Method\": Body.payment_mode default \"\",\n        \"Payment_Reference\": paymentReference,\n        \"PostingDate\": postingDate,\n        //\"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((Body.record_id default \"\") as String),\n        \"Description\": Body.user_code default \"\",\n        \"SalespersonCode\": Body.user_code default \"\"\n    },\n\n    \"Lines\":\n        if (!isEmpty(Body.invoices))\n            Body.invoices map (invoice) -\u003e {\n                \"InvoiceNo\": invoice.erp_reference default \"\",\n                \"Amount_Allocated\": invoice.amount default 0\n            }\n        else\n            []\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Payment_Rece