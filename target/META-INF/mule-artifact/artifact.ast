_System\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_System default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_GUID\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_GUID default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Environment\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Environment default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Company\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Company default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Check TARGET_System\" doc:id\u003d\"ebb21b5e-bb75-48b5-8ba4-ff5fc6084f2b\"\u003e\r\n\u003cwhen expression\u003d\"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]\"\u003e\r\n\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"1385bacb-cdd9-4fbf-9a06-67bea7ccc4de\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json skipNullOn\u003d\"everywhere\"\nvar Body \u003d vars.Body\nvar postingDate \u003d\n    if (Body.record_date !\u003d null)\n        (Body.record_date as String splitBy \" \")[0]\n    else\n        null\n---\n\n{\n  \"TransferHeader\": {\n    \"Transfer_No\": \"\",\n    \"Transfer_from_Code\": Body.from_warehouse,\n    \"Transfer_to_Code\": Body.to_warehouse,\n    \"Direct_Transfer\": false,\n    \"EXT_Doc_Ref_No\": Body.record_id as Number default \"\",\n    \"In_Transit_Code\": \"YR\",//Lisa to confirm hard coding \n    \"Posting_Date\": postingDate,//Lisa to confirm mapping\n    //\"Shipment_Date\":  postingDate,//Not Required to be auto populated by BC\n    //\"Receipt_Date\":  postingDate,//Not Required to be auto populated by BC\n    \"Assigned_user\": \"\"\n    //\"Shortcut_Dimensi