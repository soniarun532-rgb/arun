t !\u003d null)\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e","startColumn":3,"startLine":47},"parameters":[{"metadata":{"docAttributes":{},"endColumn":22,"endLine":80,"fileName":"adapter-get-sys.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/adapter-get-sys.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":22},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":49},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":49},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":80},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":21},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":80},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"},"IS_CDATA":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nfun numericProductId(code) \u003d ((code default \"\") as String) replace /^[A-Za-z]+/ with \"\"\nvar rows \u003d payload.data default payload default []\n---\n{\n\tdata: rows map ((sale) -\u003e do {\n\t\tvar createdAt \u003d sale.CREATED_AT as DateTime\n\t\t---\n\t\t{\n\t\t\tSTOREID: sale.SHOPID default \"\",\n\t\t\tDiscount: sale.DISCOUNT default \"\",\n\t\t\tSalesRepID: sale.USERID default \"\",\n\t\t\tVATAmount: sale.TOTAL_VAT default \"\",\n\t\t\tRouteID: sale.ROUTEID default \"\",\n\t\t\tDistributorID: \"\",\n\t\t\tProductID: numericProductId(sale.PRODUCT_CODE),\n\t\t\tWarehouseID: sale.SUPPLIER_ID default \"\",\n\t\t\tOrderNumber: sale.SALE_ORDER_ID default \"\",\n\t\t\tInvoiceNumber: sale.ENTRY_ID default \"\",\n\t\t\tInvoiceDate: createdAt as String {format: \"dd/MM/yyyy\"} default \"\",\n\t\t\tInvoiceTime: createdAt 