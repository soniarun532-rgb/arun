iceDate: createdAt as String {format: \"dd/MM/yyyy\"} default \"\",\n\t\t\tInvoiceTime: createdAt as String {format: \"HH:mm:ss\"} default \"\",\n\t\t\tInvoiceStatus: sale.PAYMENT_STATUS default \"\",\n\t\t\tUnitOfMeasure: sale.PACKAGING default \"\",\n\t\t\tCurrency: \"KES\",\n\t\t\tQuantityInvoiced: sale.QUANTITY default \"\",\n\t\t\tAmountInvoiced: sale.VALUE_SOLD default \"\",\n\t\t\tTransType: sale.ENTRY_TYPE default \"\"\n\t\t}\n\t}),\n\t(next: payload.next) if (payload.next !\u003d null)\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Prefix next with Experience base URL\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar expBase \u003d p(\"exp.base.url\") default \"\"\nvar papiPath \u003d p(\"sys.solutech.adapter.invoice.path\") default \"/api/Adapter_Invoice\"\nfun toExpNext(n) \u003d do {\n\tvar s \u003d n as String default \"\"\n\tvar q \u003d if (s contains \"?\") ((s splitBy \"?\")[1] default \"\") else \"\"\n\t---\n\texpBase ++ papiPath ++ (if (q !\u003d \"\") (\"?\" ++ q) else \"\")\n}\n---\npayload update {\n\tcase .next if (payload.next !\u003d null) -\u003e toExpNext(payload.next)\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" message\u003d\"#[\"Ending the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":35},"parameters":[{"unresolvedValue":"get-Adapter_Invoice-main-impl","metadata":{"docAttributes":{"id":"8a82a7a9-2042-47b8-af10-d0feb062b322"},"endColumn":9,"endLine":104,"fileName":"adapter-get-sys.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/adapter-get-sys.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":