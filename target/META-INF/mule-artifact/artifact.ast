{"name":"when","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTE"}},"fileName":"main.xml","line":291,"column":4},{"partPath":"processors"},{"partPath":"0","partIdentifier":{"identifier":{"name":"transform","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"type":{"name":"OPERATION"}},"fileName":"main.xml","line":292,"column":5}],"location":"Adapter_Inventory_Transfer_Request-main/processors/3/route/0/processors/0"},"metadata":{"docAttributes":{"name":"SAT to BC Mappings","id":"1385bacb-cdd9-4fbf-9a06-67bea7ccc4de"},"endColumn":20,"endLine":330,"fileName":"main.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/main.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":20},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":292},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":292},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":330},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":96},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":330},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"1385bacb-cdd9-4fbf-9a06-67bea7ccc4de\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json skipNullOn\u003d\"everywhere\"\nvar Body \u003d vars.Body\nvar postingDate \u003d\n    if (Body.record_date !\u003d null)\n        (Body.record_date as String splitBy \" \")[0]\n    else\n        null\n---\n\n{\n  \"TransferHeader\": {\n    \"Transfer_No\": \"\"