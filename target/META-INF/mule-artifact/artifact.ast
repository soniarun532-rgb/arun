ains error.errorType.identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains error.errorType.identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains error.errorType.identifier ) 403\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( error.errorType.identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( error.errorType.identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( error.errorType.identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains error.errorType.identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains error.errorType.identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains error.errorType.identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains error.errorType.identifier ) 504\n    else 500]]\u003e\u003c/ee:set-variable\u003e","startColumn":8,"startLine":89},"groupModelName":"SetVariable","modelName":"variableName","value":{"aString":"httpStatus"},"defaultValue":false},{"groupModelName":"SetVariable","modelName":"name","value":{},"defaultValue":true}],"extensionModel":{"name":"ee"},"modelName":"SetVariable","modelType":"TYPE","annotations":{}}]},"defaultValue":true}],"extensionModel":{"name":"ee"},"modelName":"transform","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"Error Mapping","{http://www.mulesoft.org/schema/mule/documentation}id":"a359402e-7e1d-44cf-a89e-aae3075972fa"}}],"componentType":"ROUTE","identifier":{"name":"otherwise","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"global-error-handler","parts":[{"partPath":"global-error-handler","partIdentifier":{"identifier":{"name":"error-handler","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ERROR_HANDLER"}},"fileName":"global-error-handler.xml","line":10,"column":2},{"partPath":"0","partIdentifier":{"identifier":{"name":"on-error-propagate","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ON_ERROR"}},"fileName":"global-error-handler.xml","line":12,"column":3},{"partPath":"processors"},{"partPath":"1","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"global-error-handler.xml","line":14,"column":4},{"partPath":"route"},{"partPath":"1","partIdentifier":{"identifier":{"name":"otherwise","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTE"}},"fileName":"global-error-handler.xml","line":41,"column":5}],"location":"global-error-handler/0/processors/1/route/1"},"metadata":{"docAttributes":{},"endColumn":17,"endLine":104,"fileName":"global-error-handler.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/global-error-handler.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":17},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":41},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":41},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":104},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":17},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":104}},"sourceCode":"\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Generic Error Logger\" doc:id\u003d\"415da0e9-bd7d-4031-a0a9-706e5101e05e\" message\u003d\"#[%dw 2.0\noutput application/json\nvar identifier \u003d error.errorType.identifier default \"\"\nvar namespace  \u003d error.errorType.namespace default \"\"\n\nvar httpStatus \u003d\n    if ( [\"INVALID_INPUT\", \"BAD_REQUEST\"] contains identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains identifier ) 403\n    else if ( identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains identifier ) 504\n    else 500\n\nvar errorMessage \u003d\n    if ( [\"EMAIL\", \"SMTP\"] contains namespace ) \"An error occurred while sending email notification\"\n    \n    else if ( namespace \u003d\u003d \"APIKIT\" ) \n        \"Request validation failed. Please check the request payload, query parameters, or URI parameters\"\n    \n    else if ( namespace \u003d\u003d \"HTTP\" ) \n        \"Failed to process request due to downstream service error\"\n    \n    else if ( namespace \u003d\u003d \"VALIDATION\" ) \"Input validation failed for the request\"\n    else if ( [\"JMS\", \"AMQP\"] contains namespace ) \"An error occurred while processing messages from the queue\"\n    else if ( namespace \u003d\u003d \"CONNECTIVITY\" ) \"Unable to connect to downstream system\"\n    else if ( namespace \u003d\u003d \"SECURITY\" ) \"Security validation failed\"\n    else if ( namespace \u003d\u003d \"PARSING\" ) \"Error while parsing request or response\"\n    else if ( namespace \u003d\u003d \"EXPRESSION\" ) \"Internal processing error occurred while evaluating the request\"\n    else \"An unexpected error occurred while processing the request\"\n---\n{\n    status: httpStatus,\n    message: errorMessage,\n    appName: p(\u0027app.name\u0027),\n    errors: [{\n        errorTitle: identifier,\n        errorMessage: error.description default \"\",\n        correlationId: correlationId\n    }]\n}]\"\u003e\u003c/logger\u003e\r\n\u003cee:transform doc:name\u003d\"Error Mapping\" doc:id\u003d\"a359402e-7e1d-44cf-a89e-aae3075972fa\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar identifier \u003d error.errorType.identifier default \"\"\nvar namespace  \u003d error.errorType.namespace default \"\"\n\nvar httpStatus \u003d\n    if ( [\"INVALID_INPUT\", \"BAD_REQUEST\"] contains identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains identifier ) 403\n    else if ( identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains identifier ) 504\n    else 500\n\nvar errorMessage \u003d\n    if ( [\"EMAIL\", \"SMTP\"] contains namespace ) \"An error occurred while sending email notification\"\n    \n    else if ( namespace \u003d\u003d \"APIKIT\" ) \n        \"Request validation failed. Please check the request payload, query parameters, or URI parameters\"\n    \n    else if ( namespace \u003d\u003d \"HTTP\" ) \n        \"Failed to process request due to downstream service error\"\n    \n    else if ( namespace \u003d\u003d \"VALIDATION\" ) \"Input validation failed for the request\"\n    else if ( [\"JMS\", \"AMQP\"] contains namespace ) \"An error occurred while processing messages from the queue\"\n    else if ( namespace \u003d\u003d \"CONNECTIVITY\" ) \"Unable to connect to downstream system\"\n    else if ( namespace \u003d\u003d \"SECURITY\" ) \"Security validation failed\"\n    else if ( namespace \u003d\u003d \"PARSING\" ) \"Error while parsing request or response\"\n    else if ( namespace \u003d\u003d \"EXPRESSION\" ) \"Internal processing error occurred while evaluating the request\"\n    else \"An unexpected error occurred while processing the request\"\n---\n{\n    status: httpStatus,\n    errorTitle: identifier,\n    message: errorMessage\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[if ( [\"INVALID_INPUT\", \"BAD_REQUEST\"] contains error.errorType.identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains error.errorType.identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains error.errorType.identifier ) 403\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( error.errorType.identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( error.errorType.identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( error.errorType.identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains error.errorType.identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains error.errorType.identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains error.errorType.identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains error.errorType.identifier ) 504\n    else 500]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/otherwise\u003e","startColumn":5,"startLine":41},"parameters":[],"extensionModel":{"name":"mule"},"modelName":"otherwise","modelType":"NESTED_ROUTE","annotations":{}}],"componentType":"ROUTER","identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"global-error-handler","parts":[{"partPath":"global-error-handler","partIdentifier":{"identifier":{"name":"error-handler","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ERROR_HANDLER"}},"fileName":"global-error-handler.xml","line":10,"column":2},{"partPath":"0","partIdentifier":{"identifier":{"name":"on-error-propagate","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ON_ERROR"}},"fileName":"global-error-handler.xml","line":12,"column":3},{"partPath":"processors"},{"partPath":"1","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"global-error-handler.xml","line":14,"column":4}],"location":"global-error-handler/0/processors/1"},"metadata":{"docAttributes":{"name":"Choice","id":"283480e4-1355-4aed-8654-bb4fc7587922"},"endColumn":13,"endLine":105,"fileNa