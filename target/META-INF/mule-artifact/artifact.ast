g.Integer","value":20},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":580},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":580},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":649},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":95},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":649},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"b81a9f81-95b9-43ae-9285-446a22ffa8af\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n\nvar Body \u003d vars.Body\n\nvar paymentReference \u003d\n    Body.payment_reference default \"\"\n\nvar postingDate \u003d\n    (Body.record_date as LocalDateTime {\n        format: \"yyyy-MM-dd HH:mm:ss\"\n    }) as Date\n    \n// Map payment modes to their respective codes\n/* {\n    \"Lines\":\n        if (!isEmpty(Body.invoices))\n            Body.invoices map (invoice, index) -\u003e {\n                \"InvoiceNo\": invoice.record_id default \"\",\n                \"Amount\": invoice.amount default Body.amount,\n                \"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((invoice.record_id default Body.record_id) as String),\n                \"PostingDate\": postingDate,\n                \"Payment_Method\": Body.payment_mode,\n                \"Payment_Reference\": paymentReference,\n                \"CustNo\": Body.customer_code,\n\t\t        \"SalespersonCode\": Body.user_code \n            }\n        else\n            [\n                {\n                    \"InvoiceNo\": \"\",\n                    \"Amount\": Body.amount,\n                    \"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((Body.record_id default \"\") as String),\n                    \"PostingDate\": postingDate,\n                    \"Payment_Method\": Body.payment_mode,\n                    \"Payment_Reference\": paymentReference,\n                    \"CustNo\": Body.customer_code,\n\t\t            \"SalespersonCode\": Body.user_code  \n                }\n            ]\n}\n*/\n---\n{\n    \"Header\": {\n        \"PaymentNo\": (Body.record_id default \"\") as String,\n        \"CustNo\": Body.customer_code default \"\",\n        \"Payment_Amount\": Body.amount default 0,\n        \"Payment_Method\": Body.payment_mode default \"\",\n        \"Payment_Reference\": paymentReference,\n        \"PostingDate\": postingDate,\n        //\"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((Body.record_id default \"\") as String),\n        \"Description\": Body.user_code default \"\",\n        \"SalespersonCode\": Body.user_code default \"\"\n    },\n\n    \"Lines\":\n        if (!isEmpty(Body.invoices))\n            Body.invoices map (invoice) -\u003e {\n                \"InvoiceNo\": invoice.erp_reference default \"\",\n                \"Amount_Allocated\": invoice.amount default 0\n            }\n        else\n            []\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":5,"startLine":580},"parameters":[{"groupModelName":"Message","modelName":"setPayload","value":{},"defaultValue":true},{"groupModelName":"Message","modelName":"setAttributes","value":{},"defaultValue":true},{"metadata":{"docAttributes":{},"endColumn":21,"endLine":648,"fileName":"main.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/main.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":6},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":21},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":582},"OPENING_TAG_START_LINE":{"type":"java.lang.