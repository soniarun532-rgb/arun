03e\r\n\u003cee:set-variable variableName\u003d\"Body\"\u003e\u003c![CDATA[payload]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"request_endpoint\"\u003e\u003c![CDATA[(if ( upper(payload.transaction_type) \u003d\u003d \"ORDER\" ) \"Integration_SalesDocument\" else if ( upper(payload.transaction_type) \u003d\u003d \"SALE\" ) (if ( isEmpty(payload.sales_order_erp_reference) ) \"Integration_CreateAndPostSalesDocument\" else \"Integration_PostSalesDocument\") else if ( upper(payload.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"Integration_CreateAndPostSalesDocument\" else \"Invalid Input\")]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"request_method\"\u003e\u003c![CDATA[(attributes.queryParams.ACTION default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_System\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_System default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_GUID\"\u003e\u003c![CDATA[(attributes.queryParams.Source_GUID default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_Environment\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_Environment default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_Company\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_Company default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_System\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_System default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_GUID\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_GUID default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Environment\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Environment default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Company\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Company default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Check TARGET_System\" doc:id\u003d\"7e0c47ff-6021-407f-9301-ce0409aa24fd\"\u003e\r\n\u003cwhen expression\u003d\"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]\"\u003e\r\n\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"dbf4f2c7-d17c-4a7d-9946-3f39b472898b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar value\u003d  (if ( upper(vars.Body.transaction_type) \u003d\u003d \"ORDER\" ) \"2\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"SALE\" ) \"1\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"5\" else \"\")\nvar Body \u003d vars.Body\nvar ts \u003d vars.Body.tax_sync_time\nvar ts_formatted \u003d (if (ts !\u003d null and ts !\u003d \"\")\n  (ts as LocalDateTime {format: \"yyyy-MM-dd HH:mm:ss\"})\n    as String {format: \"yyyy-MM-dd\u0027T\u0027HH:mm:ss\"}\nelse\n  ts)\n---\n//This is for sales with order(Converting sales orders to posted sales invoices)\nif ( vars.request_endpoint\u003d\u003d \"Integration_PostSalesDocument\" ) ({\n\t\"Documents\": [{\n\t\t\"Document_No\": Body.sales_order_erp_reference,\n\t\t\"Document_Type\": 2,\n\t\t\"Ship\": true,\n\t\t\"Invoice\": true,\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number,\n\t\t\"Items\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\t\"No.\": item.item_code,\n\t\t\t\"QtyToShip\": item.item_quantity,\n\t\t\t\"QtyToInvoice\": item.item_quantity\n\t\t})\n\t}]\n})\n//This is for orders and credit notes\nelse if ( vars.request_endpoint\u003d\u003d \"Integration_SalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": Body.lpo_number default \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,//1\u003dG/L Account, 2\u003dItem, 3\u003dResource\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\", //agreed with Lisa that the system will be auto populating it\n\t\t//\"VAT_Prod_Posting_Group\": \"\",//agreed with Lisa that the system will be auto populating it\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"//agreed with Lisa that the system will be auto populating it\n\t})\n})\n//This is for direct sales(Van sales) creation of Invoice and direct posting \nelse if ( vars.request_endpoint\u003d\u003d \"Integration_CreateAndPostSalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t//\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Promised_Delivery_Date\": \"2026-02-12\",\n\t\t\"External_Document_No\": Body.record_id as Number default \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t//\"Campaign_No\": \"\",\n\t\t//\"Opportunity_No\": \"\",\n\t\t//\"Responsibility_Center\": \"\",\n\t\t//\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\",\n\t\t//\"Invoice_ID\": Body.tax_verification_code\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 1,//1\u003d Item, 2\u003dG/L Account, 3\u003dResource,4\u003dFixed Asset\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate,\n\t\t\"Unit_Of_Measure\": item.uom_code,\n\t\t\"Location_Code\": item.store_code //confirmed by Lisa it is required \n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})\nelse \n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": Body.lpo_number default \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"4d397f68-770e-446f-8d81-5c0c9c5d851c\"\u003e\r\n\u003cwhen expression\u003d\"#[([\"1\",\"2\",\"5\"] contains (vars.TransformedPayload.SalesHeader.Document_Type)) or ([2] contains (vars.TransformedPayload.Documents.Document_Type[0]))]\"\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Sales_Document-subflow\" doc:id\u003d\"56fa5c40-ee73-4897-8e9c-864a6d9dd590\" name\u003d\"post-Business-Central-Adapter_Sales_Document-Subflow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"2c96f8fe-4d33-4946-9b9e-dffd78122d56\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"Message\": \"INVALID VALUE: Sale,Order \u0026 Credit Note not found as a Document Type\"\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"TARGET_System\" doc:id\u003d\"3d5c4ebf-689e-45a6-bab3-7a5f57da6900\" message\u003d\"#[lower(vars.TARGET_System)]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" doc:id\u003d\"6fb05fd9-61db-47f0-a8ed-3acbe4f7e487\" message\u003d\"#[\"Ending the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":363},"parameters":[{"unresolvedValue":"Adapter_Sales_Document-main","metadata":{"docAttributes":{"id":"01f2bd15-3c8c-4513-8caf-6273362db23c"},"endColumn":8,"endLine":558,"fileName":"main.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/main.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":8},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":363},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":363},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":558},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":1},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":90},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":558}},"sourceCode":"\u003cflow name\u003d\"Adapter_Sales_Document-main\" doc:id\u003d\"01f2bd15-3c8c-4513-8caf-6273362db23c\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Start Logger\" doc:id\u003d\"0cfd083a-a549-4c25-a040-da44856397ad\" message\u003d\"#[\"Starting the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"[Sys-Solutech] POST /Adapter_Sales_Document invoked. Payload,queryParams\" doc:id\u003d\"02e98bd3-f735-4174-b62a-08703f1964c3\" message\u003d\"[Sys-Solutech] POST /Adapter_Sales_Document invoked. Payload: #[payload],queryParams:#[attributes.queryParams]\"\u003e\u003c/logger\u003e\r\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"e170b4f1-fd0c-4b6a-ad05-7d59e1c57c22\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"Body\"\u003e\u003c![CDATA[payload]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"request_endpoint\"\u003e\u003c![CDATA[(if ( upper(payload.transaction_type) \u003d\u003d \"ORDER\" ) \"Integration_SalesDocument\" else if ( upper(payload.transaction_type) \u003d\u003d \"SALE\" ) (if ( isEmpty(payload.sales_order_erp_reference) ) \"Integration_CreateAndPostSalesDocument\" else \"Integration_PostSalesDocument\") else if ( upper(payload.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"Integration_CreateAndPostSalesDocument\" else \"Invalid Input\")]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"request_method\"\u003e\u003c![CDATA[(attributes.queryParams.ACTION default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_System\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_System default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_GUID\"\u003e\u003c![CDATA[(attributes.queryParams.Source_GUID default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_Environment\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_Environment default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"SOURCE_Company\"\u003e\u003c![CDATA[(attributes.queryParams.SOURCE_Company default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_System\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_System default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_GUID\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_GUID default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Environment\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Environment default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"TARGET_Company\"\u003e\u003c![CDATA[(attributes.queryParams.TARGET_Company default null)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Check TARGET_System\" doc:id\u003d\"7e0c47ff-6021-407f-9301-ce0409aa24fd\"\u003e\r\n\u003cwhen expression\u003d\"#[lower(vars.TARGET_System ) \u003d\u003d \"bc\"]\"\u003e\r\n\u003cee:transform doc:name\u003d\"SAT to BC Mappings\" doc:id\u003d\"dbf4f2c7-d17c-4a7d-9946-3f39b472898b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"TransformedPayload\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar value\u003d  (if ( upper(vars.Body.transaction_type) \u003d\u003d \"ORDER\" ) \"2\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"SALE\" ) \"1\" else if ( upper(vars.Body.transaction_type) \u003d\u003d \"CREDIT NOTE\" ) \"5\" else \"\")\nvar Body \u003d vars.Body\nvar ts \u003d vars.Body.tax_sync_time\nvar ts_formatted \u003d (if (ts !\u003d null and ts !\u003d \"\")\n  (ts as LocalDateTime {format: \"yyyy-MM-dd HH:mm:ss\"})\n    as String {format: \"yyyy-MM-dd\u0027T\u0027HH:mm:ss\"}\nelse\n  ts)\n---\n//This is for sales with order(Converting sales orders to posted sales invoices)\nif ( vars.request_endpoint\u003d\u003d \"Integration_PostSalesDocument\" ) ({\n\t\"Documents\": [{\n\t\t\"Document_No\": Body.sales_order_erp_reference,\n\t\t\"Document_Type\": 2,\n\t\t\"Ship\": true,\n\t\t\"Invoice\": true,\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number,\n\t\t\"Items\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\t\"No.\": item.item_code,\n\t\t\t\"QtyToShip\": item.item_quantity,\n\t\t\t\"QtyToInvoice\": item.item_quantity\n\t\t})\n\t}]\n})\n//This is for orders and credit notes\nelse if ( vars.request_endpoint\u003d\u003d \"Integration_SalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": Body.lpo_number default \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,//1\u003dG/L Account, 2\u003dItem, 3\u003dResource\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\", //agreed with Lisa that the system will be auto populating it\n\t\t//\"VAT_Prod_Posting_Group\": \"\",//agreed with Lisa that the system will be auto populating it\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"//agreed with Lisa that the system will be auto populating it\n\t})\n})\n//This is for direct sales(Van sales) creation of Invoice and direct posting \nelse if ( vars.request_endpoint\u003d\u003d \"Integration_CreateAndPostSalesDocument\" )\n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t//\"Solutech_Ref_No\": \"\",\n\t\t//\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t//\"Promised_Delivery_Date\": \"2026-02-12\",\n\t\t\"External_Document_No\": Body.record_id as Number default \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t//\"Campaign_No\": \"\",\n\t\t//\"Opportunity_No\": \"\",\n\t\t//\"Responsibility_Center\": \"\",\n\t\t//\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\",\n\t\t//\"Invoice_ID\": Body.tax_verification_code\n\t\t\"TaxInvoiceNumber\": Body.tax_invoice_number,\n\t\t\"TaxVerificationCode\": Body.tax_verification_code,\n\t\t\"TaxReceiptNumber\": Body.tax_receipt_number,\n\t\t\"TaxQRCode\": Body.tax_qr_code,\n\t\t\"TaxSyncTime\": ts_formatted,\n\t\t\"TaxPrinter\": Body.tax_printer,\n\t\t\"TaxIdentificationNumber\": Body.tax_identification_number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 1,//1\u003d Item, 2\u003dG/L Account, 3\u003dResource,4\u003dFixed Asset\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate,\n\t\t\"Unit_Of_Measure\": item.uom_code,\n\t\t\"Location_Code\": item.store_code //confirmed by Lisa it is required \n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})\nelse \n({\n\t\"SalesHeader\": {\n\t\t\"Invoice_No\": Body.lpo_number default \"\",\n\t\t\"Customer_No\": Body.customer_code,\n\t\t\"Document_Type\": value,\n\t\t\"Currency_Code\": \"\",\n\t\t\"Solutech_Ref_No\": \"\",\n\t\t\"Due_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Requested_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"Promised_Delivery_Date\": (Body.expected_delivery_date splitBy  \" \")[0],\n\t\t\"External_Document_No\": \"\",\n\t\t\"Your_Reference\": \"\",\n\t\t\"Salesperson_Code\": Body.user_code,\n\t\t\"Campaign_No\": \"\",\n\t\t\"Opportunity_No\": \"\",\n\t\t\"Responsibility_Center\": \"\",\n\t\t\"Assigned_User_ID\": Body.user_name,\n\t\t\"EXT_Doc_Ref_No\": Body.record_id as Number default \"\"\n\t},\n\t\"SalesLine\": Body.item_list map ((item, index) -\u003e\n        {\n\t\t\"Line_Type\": 2,\n\t\t\"Item_No\": item.item_code,\n\t\t\"Quantity\": item.item_quantity,\n\t\t\"Unit_Price\": item.item_price,\n\t\t\"Discount_Percentage\": item.discount_rate\n\t\t//\"Gen_Prod_Posting_Group\": \"CONSUMABLES\",\n\t\t//\"VAT_Prod_Posting_Group\": \"\",\n\t\t//\"Gen_Bus_Posting_Group\": \"DOMESTIC\"\n\t})\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"4d397f68-770e-446f-8d81-5c0c9c5d851c\"\u003e\r\n\u003cwhen expression\u003d\"#[([\"1\",\"2\",\"5\"] contains (vars.TransformedPayload.SalesHeader.Document_Type)) or ([2] contains (vars.TransformedPayload.Documents.Document_Type[0]))]\"\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Sales_Document-subflow\" doc:id\u003d\"56fa5c40-ee73-4897-8e9c-864a6d9dd590\" name\u003d\"post-Business-Central-Adapter_Sales_Document-Subflow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"2c96f8fe-4d33-4946-9b9e-dffd78122d56\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"Message\": \"INVALID VALUE: Sale,Order \u0026 Credit Note not found as a Document Type\"\n}]]\u