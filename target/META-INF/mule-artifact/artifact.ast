identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains identifier ) 403\n    else if ( identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains identifier ) 504\n    else 500\n\nvar errorMessage \u003d\n    if ( [\"EMAIL\", \"SMTP\"] contains namespace ) \"An error occurred while sending email notification\"\n    \n    else if ( namespace \u003d\u003d \"APIKIT\" ) \n        \"Request validation failed. Please check the request payload, query parameters, or URI parameters\"\n    \n    else if ( namespace \u003d\u003d \"HTTP\" ) \n        \"Failed to process request due to downstream service error\"\n    \n    else if ( namespace \u003d\u003d \"VALIDATION\" ) \"Input validation failed for the request\"\n    else if ( [\"JMS\", \"AMQP\"] contains namespace ) \"An error occurred while processing messages from the queue\"\n    else if ( namespace \u003d\u003d \"CONNECTIVITY\" ) \"Unable to connect to downstream system\"\n    else if ( namespace \u003d\u003d \"SECURITY\" ) \"Security validation failed\"\n    else if ( namespace \u003d\u003d \"PARSING\" ) \"Error while parsing request or response\"\n    else if ( namespace \u003d\u003d \"EXPRESSION\" ) \"Internal processing error occurred while evaluating the 