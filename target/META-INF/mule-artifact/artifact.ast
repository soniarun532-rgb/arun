ed by BC\n    \"Assigned_user\": \"\"\n    //\"Shortcut_Dimension_1\": \"FOP.ADMIN\",//Not Required to be auto populated by BC\n    //\"Shortcut_Dimension_2\": \"\"//Not Required to be auto populated by BC\n  },\n  \"TransferLine\": Body.item_list map ((item, index) -\u003e {\n      \"Item_No\": item.item_code,\n      \"Quantity\": item.item_quantity as Number,\n      \"Qty_to_Ship\": item.item_quantity as Number\n      //\"Shipment_Date\": postingDate,//Not Required to be auto populated by BC\n      //\"Receipt_Date\": postingDate//Not Required to be auto populated by BC\n    } )\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"post-Business-Central-Adapter_Inventory_Transfer_Request-subflow\" doc:id\u003d\"c203564e-904e-4106-9703-673ea21fb85b\" name\u003d\"post-Business-Central-Adapter_Inventory_Transfer_Request-subflow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" doc:id\u003d\"6193818d-0f55-4b37-bf83-29d3b389578d\" message\u003d\"#[\"Ending the \" ++ flow.name ++ \" at \" ++ now() as String]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"TARGET_System\" doc:id\u003d\"33591915-c099-4659-9aff-910fe8fc2096\" message\u003d\"#[lower(vars.TARGET_System)]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e","startColumn":3,"startLine":290},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{h