e":"java.lang.Integer","value":21},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":17},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":17},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":39},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":6},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":93},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":39},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"Error Response\" doc:id\u003d\"a45ee9f8-134e-4ef7-b000-67a15c6184a5\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nerror.errorMessage.payload]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[if ( [\"INVALID_INPUT\", \"BAD_REQUEST\"] contains error.errorType.identifier ) 400\n    else if ( [\"UNAUTHORIZED\", \"MUTUAL_AUTHENTICATION\", \"INVALID_SESSION_ID\"] contains error.errorType.identifier ) 401\n    else if ( [\"FORBIDDEN\", \"INSUFFICIENT_PERMISSION\"] contains error.errorType.identifier ) 403\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_FOUND\" ) 404\n    else if ( error.errorType.identifier \u003d\u003d \"METHOD_NOT_ALLOWED\" ) 405\n    else if ( error.errorType.identifier \u003d\u003d \"NOT_ACCEPTABLE\" ) 406\n    else if ( error.errorType.identifier \u003d\u003d \"UNSUPPORTED_MEDIA_TYPE\" ) 415\n    else if ( error.errorType.identifier \u003d\u003d \"STREAM_MAXIMUM_SIZE_EXCEEDED\" ) 413\n    else if ( [\"TOO_MANY_REQUESTS\", \"LIMIT_EXCEEDED\"] contains error.errorType.identifier ) 429\n    else if ( [\"CONNECTIVITY\", \"BAD_GATEWAY\", \"COMMUNICATION\", \"INVALID_RESPONSE\"] contains error.errorType.identifier ) 502\n    else if ( [\"SERVICE_UNAVAILABLE\", \"UNAVAILABLE\"] contains error.errorType.identifier ) 503\n    else if ( [\"TIMEOUT\", \"GATEWAY_TIMEOUT\", \"RETRY_EXHAUSTED\"] contains error.errorType.identifier ) 504\n    else 500]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":6,"startLine":17},"parameters":[{"metadata":{"docAttributes":{},"endColumn":47,"endLine":22,"fileName":"global-error-handler.xml","fileUri":"file:/C:/Users/ArunSoni/AnypointStudio/studio-workspace/prc-solutech-api-v1-1.0.104-mule-application/src/main/mule/global-error-handler.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":8},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":47},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":19},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":19},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":22},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":30},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":25},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":22},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"},"IS_CDATA":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nerror.errorMessage.payload]]\u003e\u003c/ee:set-payload\u003e","startColumn":8,"startLine":19},"groupModelName":"Message","modelName":"setPayload","value":{"singlePojoComponentAstDto":{"directChildren":[],"componentType":"UNKNOWN","identifier":{"name":"set-payload","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"location":{"name":"global-error-handler","parts":[{"partPath":"global-error-handler","partIdentifier":{"identifier":{"name":"error-handler","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ERROR_HANDLER"}},"fileName":"global-error-handler.xml","line":10,"column":2},{"partPath":"0","partIdentifier":{"identifier":{"name":"on-error-propagate","