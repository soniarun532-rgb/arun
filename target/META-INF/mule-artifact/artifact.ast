      ]\n}\n*/\n---\n{\n    \"Header\": {\n        \"PaymentNo\": (Body.record_id default \"\") as String,\n        \"CustNo\": Body.customer_code default \"\",\n        \"Payment_Amount\": Body.amount default 0,\n        \"Payment_Method\": Body.payment_mode default \"\",\n        \"Payment_Reference\": paymentReference,\n        \"PostingDate\": postingDate,\n        //\"Description\": (Body.user_code default \"\") ++ \"-\" ++ ((Body.record_id default \"\") as String),\n        \"Description\": Body.user_code default \"\",\n        \"SalespersonCode\": Body.user_code default \"\"\n    },\n\n    \"Lines\":\n        if (!isEmpty(Body.invoices))\n            Body.invoices map (invoice) -\u003e {\n                \"InvoiceNo\": invoice.erp_reference default \"\",\n                \"Amount_Allocated\": invoice.amount default 0\n            }\n        else\n            []\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e","startColumn":6,"startLine":582},"groupModelName":"Set Variables","modelName":"variables","value":{"listOfPojoComponentAstDto":[{"directChildren":[],"componentType":"UNKNOWN","identifier":{"name":"set-variable","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"location":{"name":"Adapter_Payment_Receipt-main","parts":[{"partPath":"Adapter_Payment_Receipt-main","partIdentifier":{"identifier":{"name":"flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"FLOW"}},"fileName":"main.xml","line":559,"column":2},{"partPath":"processors"},{"partPath":"3","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"main.xml","line":578,"column":3},{"partPath":"route"},{"partPath":"0","partIdentifier":{"identifier":{"name":"when","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTE"}},"fileName":"main.xml","line":579,"column