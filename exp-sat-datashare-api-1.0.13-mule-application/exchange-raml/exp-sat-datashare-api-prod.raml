#%RAML 1.0
title: exp-sat-datashare-api-prod
version: v1
protocols: [ HTTPS ]
baseUri: https://api.example.com/exp-sat-datashare-api-prod

traits:
  invoiceQuery: !include traits/invoice-query.raml
  orderQuery: !include traits/order-query.raml
  productQuery: !include traits/product-query.raml
  routeQuery: !include traits/route-query.raml
  salesRepQuery: !include traits/salesrep-query.raml
  stockQuery: !include traits/stock-query.raml
  customerQuery: !include traits/customer-query.raml
  warehouseQuery: !include traits/warehouse-query.raml
  errorResponses: !include traits/error-responses.raml

resourceTypes:
  collection: !include resourceTypes/collection.raml

/v1/Invoice:
  type: collection
  is:
    - invoiceQuery

/v1/Order:
  type: collection
  is:
    - orderQuery

/v1/Product:
  type: collection
  is:
    - productQuery

/v1/Route:
  type: collection
  is:
    - routeQuery

/v1/SalesRep:
  type: collection
  is:
    - salesRepQuery

/v1/Stock:
  type: collection
  is:
    - stockQuery

/v1/Customer:
  type: collection
  is:
    - customerQuery

/v1/Warehouse:
  type: collection
  is:
    - warehouseQuery
