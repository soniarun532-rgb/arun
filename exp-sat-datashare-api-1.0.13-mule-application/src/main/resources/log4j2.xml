<?xml version="1.0" encoding="utf-8"?>
<Configuration status="WARN" name="exp-sat-datashare-api">

     <!--These are some of the loggers you can enable. 
        There are several more you can find in the documentation. 
        Besides this log4j configuration, you can also use Java VM environment variables
        to enable other logs like network (-Djavax.net.debug=ssl or all) and 
        Garbage Collector (-XX:+PrintGC). These will be append to the console, so you will 
        see them in the mule_ee.log file. -->
     <Properties>
       <Property name="logLevel">${sys:logLevel:-INFO}</Property>
     </Properties>

    <Appenders>
        <RollingFile name="file" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}sys-bc-api-v7.log"
                     filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}sys-bc-api-v7-%i.log">
            
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10MB"/>
            <DefaultRolloverStrategy max="10"/>

            <!-- 🔹 STRICT FILTERING: Allow ONLY ERROR, INFO, and TRACE logs -->
            <Filters>
                <RegexFilter regex=".*(ERROR|INFO|TRACE).*" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>

        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- ✅ Only ERROR, INFO, and TRACE will be logged -->
        <AsyncLogger name="org.mule.service.http" level="ERROR"/>
        <AsyncLogger name="org.mule.extension.http" level="ERROR"/>
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>
        <AsyncLogger name="org.mule.runtime.core.internal.routing" level="TRACE"/>
        
        <!-- 🔹 ROOT LOGGER with strict level control -->
        <!-- Use dynamic log level from configuration.properties -->
        <AsyncRoot level="${logLevel}">
            <AppenderRef ref="file"/>
        </AsyncRoot>
    </Loggers>

</Configuration>