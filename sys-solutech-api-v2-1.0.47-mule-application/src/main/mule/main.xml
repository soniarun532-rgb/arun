<?xml version="1.0" encoding="UTF-8"?> <mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd  http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">


    <!-- Flow to post customers to Solutech ERP -->
        <!-- Flow to post products to Solutech ERP -->
            <!-- Flow to post prices to Solutech ERP -->
                <!-- Flow to post stock-transfer to Solutech ERP -->

<sub-flow name="post:\oauth\token:application\x-www-form-urlencoded:solutech-system-main-config"
          doc:id="7ac53c00-1505-448c-986f-4ce53c3780b4">

    <logger level="INFO"
            message="Client Secret: #[if (p('env') == 'dev') p('secure::erp.solutechlabs.client_secret') else '********']"
            doc:name="Client Secret"/>

    <http:request method="POST" path="/oauth/token" config-ref="HTTP_Request_Solutech_Token_config" doc:name="GET Solutech_Token">
                <reconnect count="3" blocking="false" />
			<http:body><![CDATA[#[%dw 2.0
output application/x-www-form-urlencoded
---
{
    grant_type: p('erp.solutechlabs.grant_type'),
    client_id: p('erp.solutechlabs.client_id'),
    client_secret: p('secure::erp.solutechlabs.client_secret'),
    scope: p('erp.solutechlabs.scope'),
    provider: p('erp.solutechlabs.provider')
}]]]></http:body>
                <http:headers><![CDATA[#[{
                    'Content-Type': 'application/x-www-form-urlencoded'
                }]]]></http:headers>
            </http:request>

    <!-- Only reached on clean success with valid JSON token response -->
    <set-variable variableName="access_token" value="#[payload.access_token]" doc:name="Token"/>
    <logger level="INFO"
            doc:name="access_token"
            message="[Token] Successfully retrieved access_token "/>

</sub-flow>

</mule>
