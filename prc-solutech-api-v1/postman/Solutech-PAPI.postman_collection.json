									"host": ["{{papi_base}}"],
									"path": ["api", "Adapter_Invoice"],
									"query": [
										{ "key": "fromDate", "value": "2026-08-01" },
										{ "key": "toDate", "value": "2026-08-26" },
										{ "key": "database", "value": "DEV_DATABASE" },
										{ "key": "supplier", "value": "DEV_SUPPLIER" },
										{ "key": "limit", "value": "10000" },
										{ "key": "offset", "value": "0" }
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{ "key": "Content-Type", "value": "application/json" }
							],
							"body": "[\n  {\n    \"STOREID\": \"123\",\n    \"Discount\": 0,\n    \"SalesRepID\": \"45\",\n    \"VATAmount\": 16,\n    \"RouteID\": \"7\",\n    \"DistributorID\": \"\",\n    \"ProductID\": \"903018\",\n    \"WarehouseID\": \"9\",\n    \"OrderNumber\": \"1001\",\n    \"InvoiceNumber\": \"2002\",\n    \"InvoiceDate\": \"13/08/2026\",\n    \"InvoiceTime\": \"21:41:25\",\n    \"InvoiceStatus\": \"PAID\",\n    \"UnitOfMeasure\": \"PCS\",\n    \"Currency\": \"KES\",\n    \"QuantityInvoiced\": 2,\n    \"AmountInvoiced\": 500,\n    \"TransType\": \"SALE\"\n  }\n]"
						}
					]
				},
