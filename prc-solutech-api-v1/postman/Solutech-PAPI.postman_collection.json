		{
			"name": "Sys (what PAPI Invoice calls)",
			"item": [
				{
					"name": "GET /api/invoice",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{access_token}}", "type": "string" }
							]
						},
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{sapi_base}}/api/invoice?fromDate={{fromDate}}&toDate={{toDate}}&database={{database}}&supplier={{supplier}}&limit={{limit}}&offset={{offset}}",
							"host": ["{{sapi_base}}"],
							"path": ["api", "invoice"],
							"query": [
								{ "key": "fromDate", "value": "{{fromDate}}" },
								{ "key": "toDate", "value": "{{toDate}}" },
								{ "key": "database", "value": "{{database}}" },
								{ "key": "supplier", "value": "{{supplier}}" },
								{ "key": "limit", "value": "{{limit}}" },
								{ "key": "offset", "value": "{{offset}}" }
							]
						},
						"description": "Joined invoice payload PAPI maps. Expect { \"data\": [ ... ] } or a raw array."
