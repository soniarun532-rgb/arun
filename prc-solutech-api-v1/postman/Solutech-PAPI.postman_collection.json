{
	"info": {
		"_postman_id": "a7c3e91b-4d2e-4f6a-9b10-adapter-invoice-get",
		"name": "Solutech PAPI — Adapter Invoice",
		"description": "Process API GET Adapter_Invoice (joined Sys invoice, no product+sale join in PAPI).\n\nListener path is /api/*, so the PAPI URL is {{papi_base}}/api/Adapter_Invoice.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "papi_base", "value": "http://localhost:8081" },
		{ "key": "sapi_base", "value": "https://sys-solutech-api-v1-5nct48.2ky31l-2.deu-c1.eu1.cloudhub.io" },
		{ "key": "access_token", "value": "test" },
		{ "key": "fromDate", "value": "2026-08-01" },
		{ "key": "toDate", "value": "2026-08-26" },
		{ "key": "database", "value": "DEV_DATABASE" },
		{ "key": "supplier", "value": "DEV_SUPPLIER" },
		{ "key": "limit", "value": "10000" },
		{ "key": "offset", "value": "0" }
	],
	"item": [
		{
			"name": "PAPI",
			"item": [
				{
					"name": "GET Adapter_Invoice",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{papi_base}}/api/Adapter_Invoice?fromDate={{fromDate}}&toDate={{toDate}}&database={{database}}&supplier={{supplier}}&limit={{limit}}&offset={{offset}}",
							"host": ["{{papi_base}}"],
							"path": ["api", "Adapter_Invoice"],
							"query": [
								{ "key": "fromDate", "value": "{{fromDate}}", "description": "Required. Inclusive start date YYYY-MM-DD" },
								{ "key": "toDate", "value": "{{toDate}}", "description": "Required. Inclusive end date YYYY-MM-DD" },
								{ "key": "database", "value": "{{database}}", "description": "Required" },
								{ "key": "supplier", "value": "{{supplier}}", "description": "Required" },
								{ "key": "limit", "value": "{{limit}}", "description": "Optional. Default 10000" },
								{ "key": "offset", "value": "{{offset}}", "description": "Optional. Default 0" }
							]
						},
						"description": "Calls Sys GET /api/invoice once, then maps fields.\nProductID strips leading letters from PRODUCT_CODE (BIC903018 → 903018).\nCurrency is always KES."
					},
					"response": [
						{
							"name": "Example mapped invoice row",
							"originalRequest": {
								"method": "GET",
								"header": [],
