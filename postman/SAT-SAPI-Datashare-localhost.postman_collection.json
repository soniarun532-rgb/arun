{
  "info": {
    "_postman_id": "sat-sapi-localhost-datashare",
    "name": "SAT SAPI localhost",
    "description": "Local SAPI GETs. Query params: database, fromDate, toDate, pageNumber, supplier. Use schema sat_nobleoutlook (not nobleoutlook).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "database",
      "value": "sat_nobleoutlook"
    },
    {
      "key": "fromDate",
      "value": "2026-08-13"
    },
    {
      "key": "toDate",
      "value": "2026-08-14"
    },
    {
      "key": "pageNumber",
      "value": "0"
    },
    {
      "key": "supplier",
      "value": "BIC EAST AFRCA LIMITED"
    }
  ],
  "item": [
    {
      "name": "GET invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/invoice?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}&supplier={{supplier}}"
      }
    },
    {
      "name": "GET order",
