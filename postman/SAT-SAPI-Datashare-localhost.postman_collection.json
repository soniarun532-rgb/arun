{
  "info": {
    "_postman_id": "sat-sapi-localhost-datashare",
    "name": "SAT SAPI localhost",
    "description": "Local SAPI GETs only. Same query params on every resource: database (optional), fromDate, toDate, pageNumber.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "database", "value": "nobleoutlook" },
    { "key": "fromDate", "value": "2026-08-13" },
    { "key": "toDate", "value": "2026-08-14" },
    { "key": "pageNumber", "value": "0" }
  ],
  "item": [
    {
      "name": "GET invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/invoice?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET order",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/order?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET product",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/product?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET route",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/route?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET sales-rep",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/sales-rep?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET store",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/store?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET inventory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inventory?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    },
    {
      "name": "GET warehouse",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/warehouse?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}"
      }
    }
  ]
}
