      }
    },
    {
      "name": "GET sales-rep",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/sales-rep?database={{database}}&fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}&supplier={{supplier}}"
      }
