    {
      "name": "GET /v1/Invoice",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{exp_base}}/api/v1/Invoice?fromDate={{fromDate}}&toDate={{toDate}}&pageNumber={{pageNumber}}",
          "host": [
            "{{exp_base}}"
          ],
          "path": [
            "api",
            "v1",
            "Invoice"
          ],
          "query": [
            {
              "key": "fromDate",
              "value": "{{fromDate}}",
              "description": "Required. Inclusive start date YYYY-MM-DD (no time)."
            },
            {
              "key": "toDate",
              "value": "{{toDate}}",
              "description": "Required. Inclusive end date YYYY-MM-DD (no time)."
            },
            {
              "key": "pageNumber",
              "value": "{{pageNumber}}",
              "description": "Optional. 0-based page. Sent as string. Page size is 10000 in SAPI properties."
            }
          ]
        },
        "description": "Public Invoice. Exp injects database and supplier from properties. Do not send them."
      }
    },
