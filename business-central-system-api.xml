    <flow name="business-central-system-api-main">
        <http:listener config-ref="business-central-system-api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="business-central-system-api-config" />
		<error-handler ref="global-error-handler" />
    </flow>
    <flow name="get-sys-config">
    <http:listener config-ref="business-central-system-api-httpListenerConfig" path="/config" doc:name="SYS Config"/>
    
    <ee:transform doc:name="Set SYS Config Payload">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    schemaversion: p('schemaversion'),
    odataMaxpageSize: p('odataMaxpageSize'),
    httpRequestHost: p('http.request.host'),
    retryCount: p('http.request.retry.count'),
    retryInterval: p('http.request.retry.interval')
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
</flow>
   
